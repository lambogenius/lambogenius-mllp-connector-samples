<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      packages/ holds Lambogenius.MllpConnector.LogicApps.<version>.nupkg (and, for sample 05,
      Lambogenius.Hl7Codec.LogicApps.<version>.nupkg), downloaded from lambogenius.com. Every sample's project finds
      them through this file. In your own project, add the folder or feed that holds them.
    -->
    <add key="lambogenius" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
